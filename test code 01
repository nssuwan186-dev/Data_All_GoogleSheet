       <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 overflow-auto pb-4">
         {/* 1. Arteries */}
         <ImportBox label="1. ระบบหน้าบ้าน (Front Office)" type="bookings" count={bookings.length} icon={BedDouble} color="bg-blue-100 text-blue-600"/>
         <ImportBox label="ข้อมูลห้องพัก (Rooms)" type="rooms" count={rooms.length} icon={FileText} color="bg-blue-50 text-blue-500"/>
         
         {/* 2. Veins */}
         <ImportBox label="2. ระบบบัญชี (Accounting)" type="accounts" count={accounts.length} icon={BookOpen} color="bg-emerald-100 text-emerald-600"/>
         
         {/* 3. Nourishment (Highlights) */}
         <ImportBox label="3. เงินเดือน (Payroll - หลายไฟล์)" type="payrolls" count={payrolls.length} icon={Briefcase} color="bg-purple-100 text-purple-600"/>
         
         {/* 4. Temperature */}
         <ImportBox label="4. สาธารณูปโภค (Utilities)" type="meters" count={meters.length} icon={Zap} color="bg-orange-100 text-orange-600"/>

         {/* 5. Immune */}
         <ImportBox label="5. รายงานราชการ (TM.30)" type="reports" count={reports.length} icon={ShieldCheck} color="bg-slate-100 text-slate-600"/>
       </div>

       <div className="mt-auto pt-6 border-t border-slate-200">
         <button onClick={handleDownloadSQL} className="w-full bg-slate-800 text-white py-4 rounded-xl font-bold text-lg shadow-lg hover:bg-slate-900 transition-all flex justify-center items-center gap-2">
           <Database className="w-6 h-6" /> Export Master Database (SQL)
         </button>
         <p className="text-center text-xs text-slate-400 mt-2">ไฟล์ SQL สามารถนำไปใช้กับ MySQL หรือฐานข้อมูลโรงแรมมาตรฐานได้ทันที</p>
       </div>
    </div>
  );

  const renderPayroll = () => (
      <div className="pb-24">
          <div className="flex justify-between items-center mb-4">
              <h2 className="text-lg font-bold">ข้อมูลเงินเดือน (Nourishment)</h2>
              <span className="bg-purple-100 text-purple-700 px-3 py-1 rounded-full text-xs font-bold">รวม: ฿{payrolls.reduce((a,b)=>a+b.netPay,0).toLocaleString()}</span>
          </div>
          <div className="space-y-3">
              {payrolls.map((p,i) => (
                  <div key={i} className="bg-white p-4 rounded-xl shadow-sm border border-slate-100">
                      <div className="flex justify-between mb-2">
                          <span className="font-bold text-slate-700">{p.employeeName}</span>
                          <span className="font-bold text-purple-600">฿{p.netPay.toLocaleString()}</span>
                      </div>
                      <div className="flex justify-between text-xs text-slate-500">
                          <span>{p.position} | งวด: {p.period}</span>
                          <span>{p.accountNo}</span>
                      </div>
                  </div>
              ))}
              {payrolls.length === 0 && <div className="text-center text-slate-400 py-10">กรุณาไปที่เมนู "จัดการข้อมูล" เพื่ออัปโหลดไฟล์เงินเดือน</div>}
          </div>
      </div>
  );

  // --- Wrapper ---
  return (
    <div className="flex h-screen bg-slate-50 font-sans text-slate-800 overflow-hidden">
      
      {/* Sidebar Overlay */}
      <div className={`fixed inset-y-0 left-0 z-50 w-72 bg-white shadow-2xl transform transition-transform duration-300 lg:static lg:translate-x-0 ${isSidebarOpen ? 'translate-x-0' : '-translate-x-full'}`}>
        <div className="p-6 flex items-center justify-between border-b border-slate-100">
           <div className="flex items-center gap-3">
             <div className="w-10 h-10 bg-indigo-600 rounded-xl flex items-center justify-center text-white font-bold text-xl">V</div>
             <div>
                 <span className="font-bold text-xl text-slate-800 block">Vipat Hotel</span>
                 <span className="text-xs text-slate-400">Ultimate Blood System</span>
             </div>
           </div>
           <button onClick={()=>setIsSidebarOpen(false)} className="lg:hidden p-1 rounded-md text-slate-400 hover:bg-slate-100"><X className="w-6 h-6"/></button>
        </div>
        <nav className="p-4 space-y-1">
          {[
            { id: 'dashboard', label: 'หน้าหลัก (Dashboard)', icon: LayoutDashboard },
            { id: 'bookings', label: '1. หน้าบ้าน (Front Office)', icon: BedDouble },
            { id: 'accounts', label: '2. บัญชี (Accounting)', icon: BookOpen },
            { id: 'payroll', label: '3. บุคคล (HR & Payroll)', icon: Briefcase },
            { id: 'meters', label: '4. มิเตอร์ (Utilities)', icon: Zap },
            { id: 'reports', label: '5. ราชการ (Compliance)', icon: ShieldCheck },
            { id: 'data', label: 'จัดการข้อมูล (Data Hub)', icon: Database, special: true },
          ].map(item => (
            <button 
              key={item.id} 
              onClick={() => { setActiveTab(item.id); if(window.innerWidth<1024) setIsSidebarOpen(false); }}
              className={`w-full flex items-center gap-3 px-4 py-3.5 rounded-xl transition-all font-bold text-sm mb-1
                ${activeTab === item.id 
                    ? 'bg-indigo-50 text-indigo-700 shadow-sm border-l-4 border-indigo-600' 
                    : item.special ? 'bg-slate-800 text-white hover:bg-slate-700 mt-6 shadow-lg' : 'text-slate-500 hover:bg-slate-50 hover:text-slate-800'}
              `}
            >
              <item.icon className={`w-5 h-5 ${activeTab === item.id ? 'text-indigo-600' : item.special ? 'text-white' : 'text-slate-400'}`}/>
              {item.label}
            </button>
          ))}
        </nav>
      </div>

      {isSidebarOpen && <div className="fixed inset-0 bg-black/40 z-40 lg:hidden backdrop-blur-sm" onClick={()=>setIsSidebarOpen(false)} />}

      <div className="flex-1 flex flex-col h-full w-full">
        <header className="bg-white h-16 border-b border-slate-200 px-4 flex items-center justify-between shrink-0 sticky top-0 z-30">
          <div className="flex items-center gap-3">
            <button onClick={()=>setIsSidebarOpen(true)} className="lg:hidden p-2 -ml-2 text-slate-600 hover:bg-slate-100 rounded-lg">
              <Menu className="w-6 h-6"/>
            </button>
            <h1 className="font-bold text-lg text-slate-800 capitalize truncate">
              {activeTab === 'dashboard' ? 'ศูนย์ควบคุม (Command Center)' : 
               activeTab === 'data' ? 'คลังเลือด (Data Hub)' : activeTab}
            </h1>
          </div>
          <div className="flex items-center gap-2">
              <span className="hidden md:inline text-xs text-slate-400">System Status: Normal</span>
              <div className="w-3 h-3 rounded-full bg-green-500 animate-pulse"></div>
          </div>
        </header>

        <main className="flex-1 overflow-x-hidden overflow-y-auto p-4 lg:p-6 bg-slate-50">
          <div className="max-w-4xl mx-auto h-full">
            {activeTab === 'dashboard' && renderDashboard()}
            
            {activeTab === 'bookings' && (
              <div className="space-y-4 pb-20">
                {bookings.map((b,i) => <DataRow key={i} title={b.customerName} subtitle={`ห้อง: ${b.roomId}`} value={`฿${b.totalPrice.toLocaleString()}`} status={b.status} icon={BedDouble} />)}
                {bookings.length===0 && <div className="text-center text-slate-400 py-10">ไม่มีข้อมูลการจอง</div>}
              </div>
            )}
            
            {activeTab === 'accounts' && (
              <div className="space-y-4 pb-20">
                {accounts.map((a,i) => <DataRow key={i} title={a.item} subtitle={a.date} value={a.in>0 ? `+${a.in.toLocaleString()}` : `-${a.out.toLocaleString()}`} colorClass={a.in>0?'bg-emerald-50/50':'bg-red-50/50'} icon={BookOpen}/>)}
                {accounts.length===0 && <div className="text-center text-slate-400 py-10">ไม่มีข้อมูลบัญชี</div>}
              </div>
            )}
            
            {activeTab === 'payroll' && renderPayroll()}
            
            {activeTab === 'meters' && (
               <div className="space-y-4 pb-20">
                {meters.map((m,i) => <DataRow key={i} title={`ห้อง ${m.room}`} subtitle={`รอบ: ${m.month}`} value={`฿${m.totalCost.toLocaleString()}`} status={`${m.totalUnit} หน่วย`} icon={Zap}/>)}
                {meters.length===0 && <div className="text-center text-slate-400 py-10">ไม่มีข้อมูลมิเตอร์</div>}
               </div>
            )}

            {activeTab === 'reports' && (
               <div className="space-y-4 pb-20">
                {reports.map((r,i) => <DataRow key={i} title={r.customerName} subtitle={`สัญชาติ: ${r.nationality}`} value={r.room} status={r.checkIn} icon={ShieldCheck}/>)}
                {reports.length===0 && <div className="text-center text-slate-400 py-10">ไม่มีรายงาน ตม. (จะสร้างอัตโนมัติเมื่อมี Booking)</div>}
               </div>
            )}

            {activeTab === 'data' && renderDataManagement()}
          </div>
        </main>
      </div>
    </div>
  );
}