              <input type="number" placeholder="จำนวนเงิน" className="w-full p-3 border rounded-lg" value={newAccount.amount} onChange={e=>setNewAccount({...newAccount, amount: e.target.value})} />
              <div className="flex gap-3">
                <button onClick={()=>setNewAccount({...newAccount, type: 'in'})} className={`flex-1 p-3 rounded-lg font-bold border ${newAccount.type==='in' ? 'bg-emerald-100 border-emerald-500 text-emerald-700' : 'bg-slate-50 border-slate-200'}`}>รายรับ (+)</button>
                <button onClick={()=>setNewAccount({...newAccount, type: 'out'})} className={`flex-1 p-3 rounded-lg font-bold border ${newAccount.type==='out' ? 'bg-red-100 border-red-500 text-red-700' : 'bg-slate-50 border-slate-200'}`}>รายจ่าย (-)</button>
              </div>
