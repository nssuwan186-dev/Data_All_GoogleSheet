        {/* Quick Action Forms (Slide Down) */}
        {showQuickAction === 'booking' && (
          <div className="mt-4 bg-white p-5 rounded-xl border-l-4 border-blue-500 shadow-lg animate-in slide-in-from-top-2">
            <h4 className="font-bold text-blue-800 mb-4 flex justify-between items-center">
              <span><BedDouble className="inline w-4 h-4 mr-2"/>Check-in ลูกค้าใหม่</span>
