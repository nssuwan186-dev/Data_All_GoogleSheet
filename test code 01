// --- Data Structures based on your CSV Analysis ---
interface Room { id: string; number: string; type: string; status: string; price: number; }
interface Booking { id: string; bookingNo: string; roomId: string; customerName: string; checkIn: string; totalPrice: number; status: string; }
interface AccountRecord { id: string; date: string; item: string; in: number; out: number; type: 'income' | 'expense'; remark: string; }
interface PayrollRecord { id: string; period: string; employeeName: string; position: string; totalIncome: number; deduction: number; netPay: number; accountNo: string; }
interface MeterRecord { room: string; month: string; prevUnit: number; currUnit: number; totalUnit: number; totalCost: number; }
interface ImmigrationReport { id: string; room: string; customerName: string; checkIn: string; nationality: string; }

// --- Helper: Advanced CSV Parser (Handle varied headers) ---
const parseCSV = (text: string) => {
  const lines = text.split('\n').filter(line => line.trim() !== '');
  if (lines.length < 2) return [];
  
  // Header Hunting: หาบรรทัดที่เป็นหัวตารางจริงๆ โดยดูจาก Keyword ในไฟล์ของคุณ
  let headerIndex = 0;
  for (let i = 0; i < Math.min(20, lines.length); i++) {
    const line = lines[i];
    if (line.includes('ลำดับ') || line.includes('วันที่') || line.includes('ห้อง') || line.includes('Booking') || line.includes('รายชื่อ') || line.includes('มิเตอร์ครั้งก่อน')) {
      headerIndex = i; break;
    }
  }
  
  const headers = lines[headerIndex].split(',').map(h => h.trim().replace(/^"|"$/g, ''));
  return lines.slice(headerIndex + 1).map(line => {
    // Regex จัดการ comma ใน quote (เช่น "1,000")
    const values = line.match(/(".*?"|[^",\s]+)(?=\s*,|\s*$)/g) || line.split(',');
    const obj: any = {};
    headers.forEach((header, index) => {
      let val = values[index] ? values[index].trim() : '';
      val = val.replace(/^"|"$/g, '');
      obj[header] = val;
    });
    return obj;
  });
};

export default function HotelBloodSystem() {
  const [activeTab, setActiveTab] = useState('dashboard');
  const [isSidebarOpen, setIsSidebarOpen] = useState(false);
  const [showQuickAction, setShowQuickAction] = useState<string | null>(null);

  // --- Auto-Collapse Logic ---
  useEffect(() => {
    const handleResize = () => {
      if (window.innerWidth >= 1024) setIsSidebarOpen(true);
      else setIsSidebarOpen(false);
    };
    handleResize();
    window.addEventListener('resize', handleResize);
    return () => window.removeEventListener('resize', handleResize);
  }, []);

  // --- 5 Core Systems Data States ---
  // 1. Arteries (Front Office)
  const [rooms, setRooms] = useState<Room[]>([]);
  const [bookings, setBookings] = useState<Booking[]>([]);
  // 2. Veins (Accounting)
  const [accounts, setAccounts] = useState<AccountRecord[]>([]);
  // 3. Nourishment (HR/Payroll)
  const [payrolls, setPayrolls] = useState<PayrollRecord[]>([]);
  // 4. Temperature (Utilities)
  const [meters, setMeters] = useState<MeterRecord[]>([]);
  // 5. Immune (Compliance)
  const [reports, setReports] = useState<ImmigrationReport[]>([]);

  // --- Form States for Quick Actions ---
  const [newBooking, setNewBooking] = useState({ name: '', room: '', price: '', date: new Date().toISOString().split('T')[0] });
  const [newAccount, setNewAccount] = useState({ item: '', amount: '', type: 'in', remark: '' });

  // --- Handlers ---
  const handleAddBooking = () => {
    if(!newBooking.name || !newBooking.room) return;
    const booking: Booking = {
      id: `bk-new-${Date.now()}`,
      bookingNo: `VP${Math.floor(Math.random()*10000)}`,
      roomId: newBooking.room,
      customerName: newBooking.name,
      checkIn: newBooking.date,
      totalPrice: parseFloat(newBooking.price) || 0,
      status: 'Check-in'
    };
    setBookings([booking, ...bookings]);
    
    // Auto-add to Immigartion Report (Immune System)
    const report: ImmigrationReport = {
        id: `tm-${Date.now()}`,
        room: newBooking.room,
        customerName: newBooking.name,
        checkIn: newBooking.date,
        nationality: 'ไทย'
    };
    setReports([report, ...reports]);

    setNewBooking({ name: '', room: '', price: '', date: new Date().toISOString().split('T')[0] });
    setShowQuickAction(null);
  };

  const handleAddAccount = () => {
    if(!newAccount.item || !newAccount.amount) return;
    const amount = parseFloat(newAccount.amount);
    const record: AccountRecord = {
      id: `ac-new-${Date.now()}`,
      date: new Date().toISOString().split('T')[0],
      item: newAccount.item,
      in: newAccount.type === 'in' ? amount : 0,
      out: newAccount.type === 'out' ? amount : 0,
      type: newAccount.type === 'in' ? 'income' : 'expense',
      remark: newAccount.remark
    };
    setAccounts([record, ...accounts]);
    setNewAccount({ item: '', amount: '', type: 'in', remark: '' });
    setShowQuickAction(null);
  };

  const handleFileUpload = (event: React.ChangeEvent<HTMLInputElement>, type: string) => {
    const files = event.target.files;
    if (!files || files.length === 0) return;
    Array.from(files).forEach(file => {
      const reader = new FileReader();
      reader.onload = (e) => {
        const text = e.target?.result as string;
        const data = parseCSV(text);
        
        // Mapping Logic based on your specific CSV structure
        if (type === 'rooms') {
            setRooms(p => [...p, ...data.map((item: any, i) => ({ 
                id: `r-${i}`, number: item['ห้อง']||'N/A', type: item['ประเภทห้อง']||'Std', status: item['สถานะ']||'Avail', price: parseFloat(item['ค่าห้องต่อคืน']||'0') 
            })).filter(r=>r.number!=='N/A')]);
        }
        else if (type === 'bookings') {
            setBookings(p => [...p, ...data.map((item: any, i) => ({ 
                id: item['Booking No.']||`b-${i}`, bookingNo: item['Booking No.']||'-', roomId: item['เบอร์ห้อง']||'', customerName: item['ชื่อลูกค้า']||'', checkIn: item['Check In']||'', totalPrice: parseFloat((item['ยอดรวมสุทธิ']||'0').replace(/,/g, '')), status: item['สถานะ']||'Active' 
            })).filter(b=>b.bookingNo!=='-')]);
        }
        else if (type === 'accounts') {
            setAccounts(p => [...p, ...data.map((item: any, i) => {
                const inc = parseFloat((item['รับ']||item['รับ (เข้า)']||'0').replace(/,/g, ''));
                const exp = parseFloat((item['จ่าย']||item['จ่าย (ออก)']||'0').replace(/,/g, ''));
                return { 
                    id: `ac-${i}`, date: item['วันที่']||'', item: item['ชื่อรายการ']||item['รายการ/ชื่อลูกค้า']||'', in: inc, out: exp, type: inc > 0 ? 'income' : 'expense', remark: item['หมายเหตุ']||'' 
                };
            })]);
        }
        else if (type === 'meters') {
            setMeters(p => [...p, ...data.map((item: any) => ({ 
                room: item['ห้อง']||item['ชื่อ-สกุล']?.split(',')?.[2]||'Unk', month: item['ประจำเดือน']||'', 
                prevUnit: parseFloat(item['มิเตอร์ครั้งก่อน']||'0'), currUnit: parseFloat(item['มิเตอร์ครั้งใหม่']||'0'),
                totalUnit: parseFloat(item['รวมหน่วย']||'0'), totalCost: parseFloat((item['รวม']||'0').replace(/,/g, '')) 
            })).filter((m: any)=>m.totalCost>0)]);
        }
        else if (type === 'payrolls') {
             // Extract period from filename e.g., "1-15 ม.ค. 68"
             let periodName = file.name.replace('.csv','').replace('สรุปจ่ายเงินเดือน 2569.xlsx - ','').trim();
             setPayrolls(p => [...p, ...data.filter((d: any)=>d['รายชื่อ']&&d['ยอดจ่ายจริง']).map((item: any, i) => ({ 
                 id: `p-${Date.now()}-${i}`, period: periodName, employeeName: item['รายชื่อ'], position: item['ตำแหน่ง'], 
                 totalIncome: parseFloat((item['รวมเงิน']||'0').replace(/,/g, '')), 
                 deduction: parseFloat((item['หักประกันสังคม']||'0').replace(/,/g, '')) + parseFloat((item['หักขาดงาน']||'0').replace(/,/g, '')),
                 netPay: parseFloat((item['ยอดจ่ายจริง']||'0').replace(/,/g, '')), accountNo: item['เลขที่บัญชี']||'-' 
             }))]);
        }
        else if (type === 'reports') {
             setReports(p => [...p, ...data.map((item: any, i) => ({
                 id: `tm-${i}`, checkIn: item['วันเวลา เข้ามาพัก']||'', room: item['ห้องพักเลขที่']||'', customerName: item['ชื่อตัวและชื่อสกุล']||'', nationality: item['สัญชาติ']||'ไทย'
             }))]);
        }
      };
      reader.readAsText(file);
    });
  };

  const generateSQL = () => {
    let sql = `-- Hotel Blood System SQL Export ${new Date().toISOString()}\n`;
    sql += `-- 1. Front Office\nINSERT INTO bookings (no, room, customer, total) VALUES \n` + bookings.map(b=>`('${b.bookingNo}','${b.roomId}','${b.customerName}',${b.totalPrice})`).join(',\n') + ';\n\n';
    sql += `-- 2. Accounting\nINSERT INTO transactions (date, item, in, out) VALUES \n` + accounts.map(a=>`('${a.date}','${a.item}',${a.in},${a.out})`).join(',\n') + ';\n\n';
    sql += `-- 3. Payroll\nINSERT INTO payroll (period, name, net_pay) VALUES \n` + payrolls.map(p=>`('${p.period}','${p.employeeName}',${p.netPay})`).join(',\n') + ';\n\n';
    return sql;
  };

  const handleDownloadSQL = () => {
