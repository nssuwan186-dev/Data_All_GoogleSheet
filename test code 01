         </div>
         <div>
           <p className="font-bold text-sm text-slate-700">{label}</p>
           <p className="text-xs text-slate-400">{count > 0 ? `${count} รายการ` : 'รอการอัปโหลด'}</p>
         </div>
       </div>
       <div className="bg-slate-50 p-2 rounded-lg text-slate-400 group-hover:bg-indigo-50 group-hover:text-indigo-600">
         <Upload className="w-4 h-4" />
       </div>
    </div>
