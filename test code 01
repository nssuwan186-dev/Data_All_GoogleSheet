        <div>
           <h3 className="text-sm font-bold text-slate-700 mb-3">การเคลื่อนไหวล่าสุด (Recent Flows)</h3>
           <div className="space-y-2">
              {bookings.slice(0, 3).map((b, i) => (
                <DataRow key={b.id} title={b.customerName} subtitle={`ห้อง ${b.roomId} | ${b.checkIn}`} value={`+฿${b.totalPrice.toLocaleString()}`} status="Booking" colorClass="bg-blue-50/50" icon={BedDouble}/>
              ))}
              {accounts.slice(0, 3).map((a, i) => (
                <DataRow key={a.id} title={a.item} subtitle={a.date} value={a.in > 0 ? `+฿${a.in.toLocaleString()}` : `-฿${a.out.toLocaleString()}`} status={a.in>0?'Income':'Expense'} colorClass={a.in > 0 ? 'bg-emerald-50/50' : 'bg-red-50/50'} icon={BookOpen}/>
              ))}
              {bookings.length === 0 && accounts.length === 0 && <div className="text-center text-slate-400 py-10 bg-slate-50 rounded-xl border border-dashed">ยังไม่มีข้อมูลในระบบเลือด</div>}
           </div>
        </div>
        
        {/* Graph: Cash Flow */}
        <div className="bg-white p-4 rounded-xl shadow-sm border border-slate-100">
           <h3 className="text-sm font-bold text-slate-700 mb-4">ชีพจรการเงิน (Financial Pulse)</h3>
           <div className="h-[200px]">
