          </div>
        )}

        {showQuickAction === 'account' && (
          <div className="mt-4 bg-white p-5 rounded-xl border-l-4 border-emerald-500 shadow-lg animate-in slide-in-from-top-2">
             <h4 className="font-bold text-emerald-800 mb-4 flex justify-between items-center">
