      {/* 2. Quick Action Center (Heart Pumping) */}
      <div>
        <h3 className="text-sm font-bold text-slate-700 mb-3 flex items-center gap-2"><Activity className="w-4 h-4 text-red-500"/> ศูนย์ปฏิบัติการ (Quick Actions)</h3>
        <div className="grid grid-cols-2 gap-3 md:grid-cols-4">
          <ActionButton label="จองห้องพัก" sub="Front Office" icon={BedDouble} color="bg-blue-600" onClick={() => setShowQuickAction('booking')} />
          <ActionButton label="ลงบัญชี" sub="Accounting" icon={BookOpen} color="bg-emerald-600" onClick={() => setShowQuickAction('account')} />
          <ActionButton label="จดมิเตอร์" sub="Utilities" icon={Zap} color="bg-orange-500" onClick={() => alert('ฟีเจอร์นี้จะเชื่อมต่อกับระบบ QR Code ในอนาคต')} />
          <ActionButton label="ออกใบ ตม." sub="Compliance" icon={ShieldCheck} color="bg-slate-600" onClick={() => alert('สร้างรายงาน TM.30 อัตโนมัติจากข้อมูล Booking')} />
