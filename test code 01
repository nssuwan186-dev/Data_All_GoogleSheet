            </h4>
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
               <input type="text" placeholder="ชื่อ-สกุล ลูกค้า" className="p-3 border rounded-lg w-full" value={newBooking.name} onChange={e=>setNewBooking({...newBooking, name: e.target.value})} />
               <input type="text" placeholder="เลขห้อง (เช่น A101)" className="p-3 border rounded-lg w-full" value={newBooking.room} onChange={e=>setNewBooking({...newBooking, room: e.target.value})} />
               <input type="number" placeholder="ราคา (บาท)" className="p-3 border rounded-lg w-full" value={newBooking.price} onChange={e=>setNewBooking({...newBooking, price: e.target.value})} />
               <input type="date" className="p-3 border rounded-lg w-full" value={newBooking.date} onChange={e=>setNewBooking({...newBooking, date: e.target.value})} />
