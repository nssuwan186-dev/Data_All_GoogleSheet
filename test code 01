  const ImportBox = ({ label, type, count, icon: Icon, color="bg-indigo-100 text-indigo-600" }: any) => (
    <div className="relative group bg-white border border-slate-200 rounded-xl p-4 flex items-center justify-between hover:border-indigo-400 transition-colors cursor-pointer mb-3">
       <input type="file" accept=".csv" multiple onChange={(e)=>handleFileUpload(e,type)} className="absolute inset-0 opacity-0 cursor-pointer z-10"/>
       <div className="flex items-center gap-3">
