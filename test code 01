  const renderDataManagement = () => (
    <div className="flex flex-col h-full pb-24">
       <div className="mb-6">
         <h2 className="text-2xl font-bold text-slate-800 mb-2 flex items-center gap-2"><Droplet className="w-6 h-6 text-red-500"/> เติมเลือดเข้าระบบ (Data Import)</h2>
         <p className="text-sm text-slate-500">อัปโหลดไฟล์ CSV จาก Google Sheet หรือ Excel เพื่ออัปเดตข้อมูลในแต่ละส่วน</p>
