        <StatCard title="รายรับ (Arteries)" value={`฿${dashboardData.totalIncome.toLocaleString()}`} icon={DollarSign} color="bg-emerald-500" trend="+12%" />
        <StatCard title="รายจ่าย (Veins)" value={`฿${dashboardData.totalExpense.toLocaleString()}`} icon={TrendingUp} color="bg-rose-500" />
        <StatCard title="กำไรสุทธิ" value={`฿${dashboardData.profit.toLocaleString()}`} icon={Landmark} color="bg-indigo-500" />
        <StatCard title="ผู้เข้าพัก (Immune)" value={bookings.length} icon={Users} color="bg-amber-500" />
